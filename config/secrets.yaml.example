# Chad AI Assistant - Secrets Configuration Template
# Copy this file to secrets.yaml and fill in your actual API keys
# IMPORTANT: secrets.yaml is gitignored - never commit real secrets

# Telegram Bot Configuration
telegram:
  bot_token: "123456789:ABCdefGHIjklMNOpqrsTUVwxyz"  # Get from @BotFather
  webhook_secret_token: "your-random-secret-string-here"  # Recommended; must match setWebhook secret_token
  # When set, Brain boot calls setWebhook to {public_base_url}/webhooks/telegram
  # so Telegram always aims at the server you just launched (e.g. fixed ngrok domain).
  # public_base_url: "https://your-subdomain.ngrok-free.dev"
  # Fail-closed allowlist — empty lists reject all inbound until you add your IDs.
  # Find your user id via @userinfobot, or set pair_on_first_message: true once to seed.
  allowed_user_ids: []   # e.g. [123456789]
  allowed_chat_ids: []   # usually same as user id for DMs
  pair_on_first_message: false  # if true AND allowlists empty, first sender is persisted then flag clears

# AI Model API Keys
GEMINI_API_KEY: "your-gemini-api-key-here"
OPENAI_API_KEY: "your-openai-api-key-here"  # Optional, for failover

# Search API Keys
BRAVE_API_KEY: "your-brave-search-api-key-here"
# Optional image search (search_images). Openverse needs no key.
PEXELS_API_KEY: "your-pexels-api-key-here"
UNSPLASH_ACCESS_KEY: "your-unsplash-access-key-here"
PIXABAY_API_KEY: "your-pixabay-api-key-here"

# Presenton (optional — self-hosted Docker uses Basic auth; cloud async API uses bearer key)
PRESENTON_API_KEY: "sk-presenton-xxxxx"
PRESENTON_AUTH_USERNAME: "chad"
PRESENTON_AUTH_PASSWORD: "your-presenton-admin-password"

# Task/Productivity Integrations
TODOIST_API_TOKEN: "your-todoist-api-token-here"

# Note-taking Integrations
NOTION_API_TOKEN: "your-notion-integration-token-here"  # Get from https://www.notion.so/my-integrations

# Version Control
GITHUB_PERSONAL_ACCESS_TOKEN: "your-github-pat-here"

# Google Workspace (OAuth — file paths to downloaded credential files)
GOOGLE_DRIVE_OAUTH_CREDENTIALS: "C:\\path\\to\\your\\credentials.json"
GOOGLE_DRIVE_MCP_TOKEN_PATH: "C:\\path\\to\\your\\token_node.json"

# Voice / Wake Word: openWakeWord is free, local, ONNX-on-CPU — no API key or
# account needed. See requirements-voice.txt / docs/features/VOICE_MODE.md.

# LangSmith (optional, for tracing/observability)
LANGCHAIN_API_KEY: "your-langsmith-api-key-here"
LANGCHAIN_PROJECT: "chad"

# E2B Code Sandbox (optional, for sandboxed code execution)
E2B_API_KEY: "your-e2b-api-key-here"

# Hubspace Smart Home (optional)
HUBSPACE_USERNAME: "your-hubspace-username"
HUBSPACE_PASSWORD: "your-hubspace-password"

# Canvas LMS (optional — Settings → Connectors → Canvas, or wizard in GUI)
CANVAS_BASE_URL: "https://your-school.instructure.com"
CANVAS_TOKEN: "your-canvas-access-token"
CANVAS_CONTACT_EMAIL: "user@example.com"  # optional — included in API User-Agent

# Remote Server Authentication
CHAD_REMOTE_TOKEN: "your-secure-remote-token-here"  # For cloud deployment

# Supabase / Multi-tenant Auth (required when CHAD_AUTH_MODE=jwt)
CHAD_AUTH_MODE: "jwt"                              # Set to "jwt" to enable Supabase JWT verification
# NOTE: SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_KEY go in `.env`
# (see .env.example), NOT here — supabase_manager.py reads them via os.getenv,
# and only .env is loaded into the process environment. A key set only here
# is silently ignored (Supabase writes fall back to the anon key instead).
# JWT verification uses JWKS (asymmetric) — no SUPABASE_JWT_SECRET needed

# Chad Email (used in prompts, e.g. for Gmail integration)
CHAD_EMAIL: "your-chad-email@example.com"

# Webhook Secrets (for verifying incoming webhooks)
webhook_secrets:
  gmail: "your-gmail-webhook-secret"
  telegram: "your-telegram-webhook-secret"
  github: "your-github-webhook-secret"
