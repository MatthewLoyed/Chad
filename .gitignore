# Memory purge backups (contain personal data — never commit)
data/memories_flatfact_backup_*.json
# Knowledge graph is runtime-generated from personal_knowledge.md — contains personal data
data/knowledge_graph.json
# Runtime entity grounding accumulates the user's browsing and query history.
data/grounded_entities.json
# WebView load marker — runtime only (see ui_build.py); distinct from ui_build_version.json
data/ui_loaded_version.json
# Deployed-build stamp — rewritten by every local rebuild (see record_ui_build_version in
# ui_build.py); tracking it caused a permanent local diff that made the one-click Update
# button's `git checkout -B` fail with "local changes would be overwritten by checkout"
data/ui_build_version.json
# Dev stack PID tracker — rewritten every Chad Dev launch
data/dev_logs/dev_stack.pids
# Per-process boot stamps (brain/gui) — used for deployed-vs-running update checks
data/runtime/
# VAPID keys for Web Push — server-specific secrets, never commit
data/push_vapid.json
/mcp/



