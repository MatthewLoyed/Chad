# Chad AI Assistant — Environment Variables
# Copy this to .env and uncomment only the services you configure.
# .env is gitignored; never commit real secrets.
#
# Most secrets go in config/secrets.yaml (see secrets.yaml.example).
# This file covers env-only overrides and runtime flags.

# --- Supabase (optional upgrade — richer memory, tool RAG, chat history sync) ---
# Dashboard → Settings → Data API for the URL, → API Keys for the keys.
# SUPABASE_SERVICE_KEY (secret, service_role) also lives here rather than
# secrets.yaml because supabase_manager.py reads it via os.getenv, not ConfigManager.
# See docs/setup/COLD_START.md for the full provisioning steps.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_your-service-role-key-here
# SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here
# Direct Postgres connection (Settings -> Database -> Connection string, URI,
# "Session" pooler mode) — used by scripts/setup/bootstrap_supabase.py to run
# migrations, and by the LangGraph checkpointer for conversation state.
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# --- AI Model API Keys ---
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# --- Search ---
# BRAVE_API_KEY=your-brave-search-api-key-here
# Optional, opt-in: cheap/free paid fallbacks used only when set — SearXNG stays the
# free default with zero required keys. See docs/features/WEB_SEARCH.md.
# SERPER_API_KEY=your-serper-api-key-here
# TAVILY_API_KEY=your-tavily-api-key-here
# Optional image search providers for search_images (Openverse works with no key).
# Free keys: https://www.pexels.com/api/ | https://unsplash.com/developers |
# https://pixabay.com/api/docs/
# PEXELS_API_KEY=your-pexels-api-key-here
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
# PIXABAY_API_KEY=your-pixabay-api-key-here

# --- Integrations ---
# TODOIST_API_TOKEN=your-todoist-token-here
# NOTION_API_TOKEN=your-notion-integration-token-here
# GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat-here

# --- Google Workspace (OAuth paths) ---
# GOOGLE_DRIVE_OAUTH_CREDENTIALS=C:\path\to\credentials.json
# GOOGLE_DRIVE_MCP_TOKEN_PATH=C:\path\to\token_node.json

# --- Voice / Wake Word ---
# PICOVOICE_ACCESS_KEY=your-picovoice-key-here

# --- Smart Home ---
# HUBSPACE_USERNAME=your-hubspace-username
# HUBSPACE_PASSWORD=your-hubspace-password

# --- Chad Email (used in prompts/Gmail) ---
# CHAD_EMAIL=your-email@example.com

# --- Remote Server ---
# CHAD_REMOTE_TOKEN=your-secure-remote-token-here
CHAD_SERVER_URL=ws://localhost:8767/ws

# --- Runtime Flags ---
# CHAD_UI_DEV=true         # Load React from Vite dev server (localhost:5173)
# CHAD_DAEMONS_ENABLED=false   # Disable background tasks (cron, heartbeat, webhooks)
# CHAD_HYBRID_SELECTION=1  # Override hybrid tool selection (0=off, 1=on)
# CHAD_LOG_LEVEL=INFO      # Log verbosity: DEBUG, INFO, WARNING, ERROR
# CHAD_HEADLESS=true       # Run without GUI
# CHAD_AUTH_MODE=hybrid    # Auth mode: token (default), jwt (Supabase JWT only), hybrid (both — use when desktop + phone PWA share the same Brain)

# --- Tracing (optional) ---
# LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=chad

# --- Sandboxed Code Execution (optional) ---
# E2B_API_KEY=your-e2b-api-key-here
