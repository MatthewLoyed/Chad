// planner_gather_first.jsonl — WORKFLOW lane (needs running server): --workflow --suite planner_gather_first
// Asserts scout gather activity appears BEFORE the plan approval snapshot on planning turns.
// These cases intentionally stop after round 1 (plan proposed) — no must_complete required.
// Sizing (refs #315): grown from 3 to 5, not to 15-20 — this is the WORKFLOW lane (real
// multi-round server turns), the most expensive free-form suite to run. 5 cases now span
// email/repo/calendar/codebase-scan domains, each forcing a genuinely different scout tool
// before the plan can be written; more cases would mostly restate the same scout-before-plan
// assertion in a new domain rather than adding new failure modes to catch.
{"id": "pgf_email_plan", "prompt": "make a plan to summarize my latest unread work emails and highlight anything urgent", "category": "planning", "expect": {"scout_before_plan": true, "gather_brief_present": true, "max_rounds": 2, "min_steps": 1}, "note": "Email-style prompt — scout should gather before planner emits plan"}
{"id": "pgf_repo_plan", "prompt": "make a plan to find the main README in my AIAssistant repo and summarize its setup steps", "category": "planning", "expect": {"scout_before_plan": true, "gather_brief_present": true, "max_rounds": 2, "min_steps": 1}, "note": "Repo/file prompt — scout gather precedes plan snapshot"}
{"id": "pgf_event_email_research_reply", "prompt": "Find the email in my inbox inviting me to an event, look up the event's date, location, and ticket cost online, then draft a reply saying whether I can attend.", "category": "planning", "expect": {"scout_before_plan": true, "gather_brief_present": true, "max_rounds": 2, "min_steps": 3}, "note": "Genuine plan-lane test: the plan is unwritable until Scout reads the inbox (which event? what's asked?). Forces 3 dependent steps across distinct tools — search_gmail (find invite) -> web_search (event details) -> draft_gmail_reply. Scout must gather only, not execute."}
{"id": "pgf_calendar_conflict_plan", "prompt": "make a plan to check my calendar for today and tell me if I have any conflicts, then suggest what to move", "category": "planning", "expect": {"scout_before_plan": true, "gather_brief_present": true, "max_rounds": 2, "min_steps": 2}, "note": "Calendar-domain scout test — plan is unwritable until Scout reads today's events; distinct tool surface (google_calendar_check) from the email/Drive cases."}
{"id": "pgf_repo_todo_scan_plan", "prompt": "make a plan to find all TODO comments in my AIAssistant repo and summarize what needs the most attention", "category": "planning", "expect": {"scout_before_plan": true, "gather_brief_present": true, "max_rounds": 2, "min_steps": 2}, "note": "Codebase-scan scout test — plan depends on Scout actually searching the repo (list_directory/fuzzy_find/grep-equivalent) before a step list can be written."}
