// tool_args.jsonl — component-layer checks: not just WHICH tool was called, but WHAT it was
// called with. LIVE-LANE ONLY (dry-run never executes a tool call, only binds schemas —
// see evals/REFERENCE.md "Live-only expect keys"). Run with --live.
{"id": "web_search_nonempty_query", "prompt": "search the web for the latest price of nvidia stock", "category": "agent", "expect": {"tools_any": ["web_search"], "tool_args": [{"tool": "web_search", "arg": "queries", "not_empty": true}]}, "note": "catches a model calling web_search with an empty/placeholder query — tools_include alone would still pass"}
{"id": "web_search_on_topic_query", "prompt": "search the web for the current weather in Seattle", "category": "agent", "expect": {"tools_any": ["web_search"], "tool_args": [{"tool": "web_search", "arg": "queries", "contains": "Seattle"}]}, "note": "catches right-tool-wrong-argument: web_search called but with a query unrelated to the actual ask"}
{"id": "volume_level_in_range", "prompt": "set my system volume to 40 percent", "category": "agent", "expect": {"tools_any": ["control_volume"], "tool_args": [{"tool": "control_volume", "arg": "level", "min": 0, "max": 100}]}, "note": "guards against a model passing a raw/garbage value (e.g. 400, -1) that would pass an unclamped API call"}
{"id": "volume_level_matches_request", "prompt": "turn my volume all the way down to 0", "category": "agent", "expect": {"tools_any": ["control_volume"], "tool_args": [{"tool": "control_volume", "arg": "level", "equals": 0}]}, "note": "exact-value check — right tool, did it use the number the user actually said?"}
{"id": "reminder_message_not_empty", "prompt": "remind me to call the dentist tomorrow at 9am", "category": "agent", "expect": {"tool_args": [{"tool": "set_reminder", "arg": "message", "not_empty": true}]}, "note": "a reminder tool called with no message is a silent no-op the user would never notice until it fires empty"}
