// information_gathering.jsonl — harness enforcement for read-before-act behavior (Front 2).
// Some cases accept delegate fallbacks until native tools/prompts land; tighten as work ships.
{"id": "email_full_thread", "prompt": "summarize the full email thread from my professor about the project deadline — read the whole conversation, not just the inbox snippet", "category": "agent", "expect": {"tools_any": ["read_gmail"], "tools_exclude": ["hubspace_control"], "max_tools": 20}, "judge": ["tool_appropriateness"], "note": "target: read_gmail; native gmail thread tools on supervisor"}
{"id": "email_github_crossref", "prompt": "check my email about the github pull request and tell me whether CI passed", "category": "agent", "expect": {"tools_any": ["search_gmail", "gmail_check_inbox"], "max_tools": 20}, "judge": ["tool_appropriateness"], "note": "email read should precede any github/code action — live lane should also bind code/github tools"}
{"id": "email_action_needs_thread", "prompt": "what should I reply to the latest email from Sam about the scholarship?", "category": "agent", "expect": {"tools_any": ["read_gmail", "search_gmail"], "max_tools": 20}, "judge": ["tool_appropriateness"]}
{"id": "inspect_before_migrate", "prompt": "help me migrate my python project from pip to uv — inspect the repo and tell me what packaging files exist first", "category": "agent", "expect": {"tools_any": ["list_directory", "read_file", "fuzzy_find_local", "delegate_to_code_agent", "delegate_to_system_agent"], "max_tools": 20}, "judge": ["tool_appropriateness"], "note": "gather/local inspect before acting — not a planner-lane case"}
