// memory_selection.jsonl — harness checks that memory-policy prompts bind manage_user_memory.
{"id": "remember_explicit", "prompt": "remember that I prefer dark mode in all my apps", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "explicit remember → save/search via manage_user_memory"}
{"id": "forget_correction", "prompt": "forget that I live in Dallas — I moved to Austin last month", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "contradiction → forget + save path"}
{"id": "recall_before_assert", "prompt": "what do you know about my work setup and coding preferences?", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "should search memory before asserting personal facts"}
{"id": "memory_not_smart_home", "prompt": "remember that I prefer espresso in the morning", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "tools_exclude": ["hubspace_control"], "max_tools": 16}, "judge": ["tool_appropriateness"]}
{"id": "remember_event_specific", "prompt": "remember that my flight to Chicago leaves at 7am on Friday", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "event/time-bound fact — distinct from a stable preference"}
{"id": "forget_stale_contact_info", "prompt": "forget my old phone number, I got a new one this week", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "forget-and-replace variant, different domain than the Dallas/Austin case"}
{"id": "recall_class_schedule", "prompt": "what have I told you about my class schedule this semester?", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "recall variant — different domain than work-setup recall"}
{"id": "recall_allergy_safety", "prompt": "do you remember what I said about my allergies?", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "safety-relevant recall — should search memory, not guess"}
{"id": "correction_tooling_switch", "prompt": "actually I don't use IntelliJ anymore, I switched to VS Code a few months ago — update that", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "explicit correction/update path, not a fresh remember"}
{"id": "remember_preference_food", "prompt": "remember that I like my coffee with oat milk, no sugar", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"]}
{"id": "remember_multi_fact", "prompt": "remember two things: I'm allergic to peanuts, and my emergency contact is Sam", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "multi-fact single save — should not require two separate memory calls to pass"}
{"id": "recall_for_personalization", "prompt": "recommend a restaurant based on what you know I like to eat", "category": "agent", "expect": {"tools_any": ["manage_user_memory"], "max_tools": 20}, "judge": ["tool_appropriateness"], "note": "implicit recall — no 'remember'/'forget' verb, but personalization requires a memory search first"}
{"id": "memory_negative_weather", "prompt": "what's the weather like in Austin today?", "category": "agent", "expect": {"tools_exclude": ["hubspace_control", "send_email"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "negative case — purely factual/external query should not pull in unrelated domain/action tools. `manage_user_memory` is intentionally always-bound (registry.py core tools), so it is NOT a valid tools_exclude target here — do not re-add that assertion"}
