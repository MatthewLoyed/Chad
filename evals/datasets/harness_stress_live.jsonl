// harness_stress_live.jsonl — light multi-tool / MCP live cases (no deep research).
// Prefer Brave via preferences search_backend; run --live --judge against :8788.
{"id": "stress_web_and_time", "prompt": "search the web for the current NVIDIA stock price, then tell me what time it is right now — do both, don't ask me questions", "category": "agent", "expect": {"tools_any": ["web_search", "get_datetime", "get_time"], "max_duration_s": 180, "response_excludes": ["i cannot", "i don't have access"]}, "judge": ["tool_appropriateness", "response_grounded"], "note": "two native tools: Brave web_search + datetime (not deep research)"}
{"id": "stress_coding_write_run", "prompt": "write a python script that reverses a list of numbers, run it on [5, 3, 8, 1], and tell me the output — do not ask me questions", "category": "agent", "expect": {"tools_any": ["write_file", "run_script", "delegate_to_code_agent"], "max_duration_s": 240, "response_includes": ["8", "1", "3", "5"]}, "judge": ["tool_appropriateness", "response_grounded"], "note": "write/run or code_agent — no sandbox required"}
{"id": "stress_github_mcp_readonly", "prompt": "search GitHub for the file that defines the MCP scanner in MatthewLoyed/AIAssistant and tell me what it does — do not ask me questions", "category": "agent", "expect": {"response_excludes": ["i cannot", "i don't have access"], "max_duration_s": 180}, "judge": ["tool_appropriateness", "response_grounded"], "note": "GitHub MCP read-only"}
