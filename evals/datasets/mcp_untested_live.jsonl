// mcp_untested_live.jsonl — issue #413: MCP add-ons that have NEVER been exercised by the
// harness (presenton, excalidraw, notion, todoist, github, google-drive). All other datasets
// only cover core/native tools; this is the first live-lane pass over the third-party MCP
// servers under `mcp_servers` in config/config.yaml (docs/guides/SERVICES_AND_MCPS.md).
//
// SAFETY (per Matthew, 2026-07-09): real creates are fine, cleanup happens later. Every prompt
// that creates something is prefixed "Chad Eval Test" (or similarly obviously-scratch) so junk
// is trivially findable and deletable afterward. NEVER ask a case to update/overwrite/delete an
// EXISTING page/issue/task/file — only create-new or read-only (search/list/get). Run against
// prod :8767 (connect-only, never restart) or dev :8788 with --live / --workflow.
//
// Tool names for third-party MCP servers are NOT hardcoded here except where confirmed in
// src/infrastructure/tools/registry.py or a skill's SKILL.md (generate_presentation,
// excalidraw create_element/batch_create_elements, google_drive_search). Everything else
// relies on the tool_appropriateness / response_grounded judges rather than a guessed tool
// name, so a case doesn't false-fail on a name mismatch — read the transcript to see what
// actually got called.
{"id": "presenton_deck_live", "prompt": "make me a polished 6-slide pptx deck titled 'Chad Eval Test - Q3 Roadmap' about a fictional product roadmap: intro, 3 feature slides, timeline, closing", "category": "agent", "expect": {"tools_any": ["generate_presentation"], "response_excludes": ["i cannot", "i don't have access"], "max_duration_s": 180}, "judge": ["tool_appropriateness", "response_grounded"], "note": "presenton sidecar untested end-to-end (issue #413); confirms load_skill->generate_presentation actually produces a downloadable artifact, not just binds"}
{"id": "excalidraw_canvas_live", "prompt": "open a live excalidraw canvas and sketch a simple 3-box flowchart titled 'Chad Eval Test' showing Start -> Process -> End", "category": "agent", "expect": {"tools_any": ["create_element", "batch_create_elements"], "max_duration_s": 120}, "judge": ["tool_appropriateness"], "note": "excalidraw MCP untested end-to-end; requires canvas sidecar (docker compose --profile excalidraw); verifies load_skill('excalidraw') -> real element creation, not a kroki fallback"}
{"id": "notion_create_page_live", "prompt": "create a new Notion page titled 'Chad Eval Test - Scratch Page' with a short bullet list of 3 fake todo items", "category": "agent", "expect": {"response_excludes": ["i cannot", "i don't have access", "not connected"], "max_duration_s": 120}, "judge": ["tool_appropriateness", "response_grounded"], "note": "notion MCP (@suekou/mcp-notion-server) never exercised by any dataset; create-only, no page named this should ever be updated/deleted by another case"}
{"id": "notion_search_readonly_live", "prompt": "search my Notion workspace for any page with 'Chad Eval Test' in the title", "category": "agent", "expect": {"max_duration_s": 60}, "judge": ["tool_appropriateness"], "note": "read-only notion search path; run AFTER notion_create_page_live to also sanity-check the created page is findable"}
{"id": "todoist_create_task_live", "prompt": "add a Todoist task called 'Chad Eval Test - scratch task, safe to delete' due tomorrow", "category": "agent", "expect": {"response_excludes": ["i cannot", "i don't have access", "not connected"], "max_duration_s": 60}, "judge": ["tool_appropriateness", "response_grounded"], "note": "todoist MCP never exercised by any dataset; create-only"}
{"id": "todoist_list_readonly_live", "prompt": "list my current Todoist tasks", "category": "agent", "expect": {"max_duration_s": 60}, "judge": ["tool_appropriateness"], "note": "read-only listing path, no side effects"}
{"id": "github_search_readonly_live", "prompt": "search GitHub for the file that defines the MCP scanner in this repo (MatthewLoyed/AIAssistant) and tell me what it does", "category": "agent", "expect": {"response_excludes": ["i cannot", "i don't have access"], "max_duration_s": 90}, "judge": ["tool_appropriateness", "response_grounded"], "note": "github MCP search_code/get_file_contents never exercised end-to-end; read-only, safe"}
{"id": "github_create_issue_live", "prompt": "open a new GitHub issue on MatthewLoyed/AIAssistant titled '[Chad Eval Test] scratch issue, safe to close' with body 'created by evals/datasets/mcp_untested_live.jsonl, safe to close/delete'", "category": "agent", "expect": {"response_excludes": ["i cannot", "i don't have access"], "max_duration_s": 90}, "judge": ["tool_appropriateness", "response_grounded"], "note": "create_issue never exercised; obviously-scratch title/body so it's trivial to bulk-close afterward. Do NOT let a case comment on or close a REAL existing issue."}
{"id": "google_drive_search_readonly_live", "prompt": "search my Google Drive for any file with 'resume' in the name and tell me what you find", "category": "agent", "expect": {"tools_any": ["google_drive_search"], "max_duration_s": 60}, "judge": ["tool_appropriateness", "response_grounded"], "note": "google_drive_search/list_folder/read_file are registered but read-side coverage in existing datasets is thin; read-only, safe"}
{"id": "presenton_then_drive_chain_live", "prompt": "make a 4-slide pptx titled 'Chad Eval Test - Weekly Update' (intro, progress, blockers, next steps) and tell me where I can download it", "category": "agent", "expect": {"tools_any": ["generate_presentation"], "max_duration_s": 180}, "judge": ["tool_appropriateness", "response_grounded"], "note": "confirms the deck-generation response actually surfaces a usable download/edit link, not just 'done'"}
