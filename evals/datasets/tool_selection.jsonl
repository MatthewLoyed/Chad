// tool_selection.jsonl — does the harness bind the right tools for each prompt?
// `expect` runs FREE (dry-run). `judge` runs with --judge. Edit/extend freely: one line = one case.
// Tool names are real (see scripts/list_registered_tools.py). Loose `tools_any` reduces RAG flakiness;
// a failure is a triage signal (real wiring/selection bug OR a threshold to tune), not always a code bug.
{"id": "email_check", "prompt": "check my emails for any updates on the project status", "category": "agent", "expect": {"tools_any": ["search_gmail", "gmail_check_inbox", "get_gmail_history"], "tools_exclude": ["control_volume", "hubspace_control"], "max_tools": 22}, "judge": ["tool_appropriateness"]}
{"id": "open_apps", "prompt": "open discord and slack, then start google chrome", "category": "agent", "expect": {"tools_any": ["open_app", "open_browser"]}, "judge": ["tool_appropriateness"]}
{"id": "coding_write_run", "prompt": "write a python script to parse a csv file, execute it, and check the output", "category": "agent", "expect": {"tools_any": ["write_file", "run_script", "run_sandboxed_python", "delegate_to_code_agent"]}, "note": "coding may be handled directly (write/run) OR delegated to the code specialist — both valid", "judge": ["tool_appropriateness"]}
{"id": "smart_home_lights", "prompt": "turn on my study desk lamp and dim the bedroom ceiling lights to 50%", "category": "agent", "expect": {"tools_any": ["hubspace_control"], "tools_exclude": ["send_email"]}, "judge": ["tool_appropriateness"]}
{"id": "screenshot", "prompt": "take a screenshot of the current screen to see what window is active", "category": "agent", "expect": {"tools_any": ["capture_screen"]}, "judge": ["tool_appropriateness"]}
{"id": "system_settings", "prompt": "increase my system audio volume to 80% and raise the screen brightness to max", "category": "agent", "expect": {"tools_any": ["control_volume", "system_settings"]}, "judge": ["tool_appropriateness"]}
{"id": "what_time", "prompt": "what time is it right now?", "category": "agent", "expect": {"tools_any": ["get_datetime"], "max_tools": 12}, "judge": ["tool_appropriateness"]}
{"id": "calendar_today", "prompt": "what is on my calendar today?", "category": "agent", "expect": {"tools_any": ["google_calendar_check"]}, "judge": ["tool_appropriateness"]}
{"id": "canvas_grades", "prompt": "what are my upcoming assignments and recent grades in canvas?", "category": "agent", "expect": {"tools_any": ["get_upcoming_assignments", "get_recent_grades", "get_canvas_dashboard_todos"]}, "judge": ["tool_appropriateness"]}
{"id": "set_reminder", "prompt": "remind me to send the report tomorrow at 9am", "category": "agent", "expect": {"tools_any": ["set_reminder", "execute_future_task", "manage_cron"]}, "judge": ["tool_appropriateness"]}
{"id": "skill_delegation", "prompt": "help me with my homework for my operating systems class", "category": "agent", "expect": {"tools_any": ["load_skill", "homework_assistant", "list_skills"]}, "note": "subagent/skill wiring — if none bound, the skill route is not reachable from selection", "judge": ["tool_appropriateness"]}
{"id": "web_search", "prompt": "search the web for the latest price of nvidia stock and summarize it", "category": "agent", "expect": {"max_system_tokens": 8000, "max_tools": 16}, "note": "Web-tool SELECTION is asserted in the LIVE lane (live_check.jsonl) where Supabase RAG + MCP match production. The dry-run uses local-embedding fallback and is NOT faithful for web/MCP tool ranking, so this case only checks budgets here."}
{"id": "greeting_negative", "prompt": "hello there! how are you doing today?", "category": "agent", "expect": {"tools_exclude": ["hubspace_control", "send_email", "run_sandboxed_python"], "max_tools": 12}, "note": "conversational — should not pull in heavy domain/action tools", "judge": ["tool_appropriateness"]}
{"id": "youtube_video_display", "prompt": "show me a youtube video about skyrizi", "category": "agent", "expect": {"tools_any": ["show_youtube_video"], "tools_exclude": ["open_browser", "youtube_toolkit", "youtube_desktop_control"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "inline YouTube card path: supervisor binds show_youtube_video + delegates research; not open_browser or youtube_toolkit"}
{"id": "pdf_report_request", "prompt": "create a pdf about how to play spikeball", "category": "agent", "expect": {"tools_any": ["compile_typst", "load_skill"], "tools_exclude": ["createTextFile", "uploadFile", "run_sandboxed_python"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "regression for #incident 2026-07-05: compile_typst was missing from the Supabase RAG index entirely, so the shortlist never surfaced it and the turn fell back to Drive MCP tools + E2B sandbox. Guards against the shortlist/preamble silently dropping the PDF tool again."}
{"id": "structured_diagram_request", "prompt": "can you make me a diagram about how to play spikeball", "category": "agent", "expect": {"tools_any": ["render_diagram", "build_html_file", "load_skill"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "diagram requests split into two real cases: structured flow/sequence/ER -> render_diagram (kroki), illustrative/explainer visuals -> build_html_file. Either is acceptable here since spikeball rules aren't inherently a flowchart; the eval should fail if NEITHER visual tool is offered."}
{"id": "flowchart_diagram_request", "prompt": "draw me a flowchart of how a pull request gets reviewed and merged", "category": "agent", "expect": {"tools_any": ["render_diagram", "load_skill"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "unambiguous structured-diagram case (real nodes/edges) — should route to render_diagram/kroki, not build_html_file"}
{"id": "marp_slides_request", "prompt": "turn these bullet points into a quick slide deck: intro, problem, solution, roadmap", "category": "agent", "expect": {"tools_any": ["render_marp", "load_skill"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "regression case: render_marp had no Supabase embedding at all before 2026-07-05 fix (only build_html_file was ever synced among the visual tools)"}
{"id": "presentation_request", "prompt": "make me a polished slide deck about our Q3 roadmap I can present to the team", "category": "agent", "expect": {"tools_any": ["generate_presentation", "render_marp", "load_skill"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "regression case: generate_presentation had no Supabase embedding at all before 2026-07-05 fix"}
{"id": "animation_preview_request", "prompt": "show me what this CSS spinner animation actually looks like before I ship it", "category": "agent", "expect": {"tools_any": ["render_animation", "load_skill"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "regression case: render_animation had no Supabase embedding at all before 2026-07-05 fix"}
{"id": "ambig_send_it_over", "prompt": "can you send that over to Sam for me", "category": "agent", "expect": {"tools_any": ["send_email", "send_telegram_message"], "tools_exclude": ["hubspace_control", "run_sandboxed_python"], "max_tools": 24}, "judge": ["tool_appropriateness"], "note": "ambiguous: no channel named (email vs telegram) and no referent for 'that' -- selector must pick a plausible communication tool or ask a clarifying question, not silently guess a random action tool. max_tools loosened to 24: a named-person send request pulls in contact/delegate tools beyond the tighter budgets used by narrower cases"}
{"id": "ambig_check_that_thing", "prompt": "did that thing I set up earlier actually go through?", "category": "agent", "expect": {"tools_any": ["manage_cron", "google_calendar_check", "search_gmail", "run_diagnostics", "ask_user_question", "web_search"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "ambiguous: 'that thing' has no antecedent in a single-turn eval -- a status-check tool OR a clarifying question is acceptable, but it must not fabricate a destructive/write action. tools_any widened to include ask_user_question/web_search: dry-run's local-embedding shortlist doesn't reliably surface narrow status tools for this indirect phrasing (same caveat as the web_search case above) -- the LIVE lane is the faithful signal for the narrow-tool claim"}
{"id": "ambig_pull_it_up", "prompt": "pull it up on screen so I can see it", "category": "agent", "expect": {"tools_any": ["open_browser", "open_file", "open_app", "capture_screen"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "ambiguous referent ('it') with no prior context -- tests that the selector doesn't default to an unrelated domain tool (e.g. hubspace_control) when the object of the request is unclear"}
{"id": "ambig_make_something_visual", "prompt": "make something visual for the standup tomorrow", "category": "agent", "expect": {"tools_any": ["render_diagram", "build_html_file", "render_marp", "generate_presentation", "load_skill"], "max_tools": 20}, "judge": ["tool_appropriateness"], "note": "genuinely ambiguous across 4+ valid visual-output tools (diagram vs slides vs generic html vs presentation) -- any one is acceptable, but selecting zero visual tools is a failure"}
{"id": "ambig_look_into_this", "prompt": "look into this for me and let me know what you find", "category": "agent", "expect": {"tools_any": ["web_search", "searxng_search", "delegate_to_code_agent", "google_drive_search"], "max_tools": 18}, "judge": ["tool_appropriateness"], "note": "ambiguous: 'this' is undefined -- research-style tools are the safest default; should not jump to write_file or run_sandboxed_python without a concrete task"}
{"id": "ambig_turn_things_down", "prompt": "turn things down a bit, it's too much right now", "category": "agent", "expect": {"tools_any": ["control_volume", "hubspace_control", "system_settings"], "tools_exclude": ["send_email"], "max_tools": 14}, "judge": ["tool_appropriateness"], "note": "ambiguous across volume/brightness/smart-home dimming -- any physical-control tool is valid, tests selector doesn't wander into unrelated domains for vague sensory complaints"}
{"id": "ambig_get_me_organized", "prompt": "help me get organized, things are a mess", "category": "agent", "expect": {"tools_any": ["organize_folder", "kanban_board", "file_manager", "list_directory", "delegate_to_traversal_agent", "ask_user_question"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "ambiguous between file-system organization and task/kanban organization -- both are reasonable readings of 'a mess'. tools_any widened to include delegate_to_traversal_agent/ask_user_question: dry-run's local-embedding shortlist doesn't reliably surface narrow filesystem tools for this indirect phrasing -- the LIVE lane is the faithful signal for the narrow-tool claim"}
{"id": "ambig_whats_going_on", "prompt": "what's going on with everything right now?", "category": "agent", "expect": {"tools_any": ["get_datetime", "system_monitor", "google_calendar_check", "update_dashboard", "ask_user_question", "web_search"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "deliberately vague status query -- should route to a broad status/summary tool or ask for clarification rather than a narrow domain action. tools_any widened: dry-run's local-embedding shortlist doesn't reliably surface narrow status tools for this indirect phrasing -- the LIVE lane is the faithful signal for the narrow-tool claim"}
{"id": "ambig_find_that_file", "prompt": "find that file from earlier, the one with the numbers in it", "category": "agent", "expect": {"tools_any": ["fuzzy_find_local", "list_directory", "google_drive_search", "find_project", "delegate_to_traversal_agent", "ask_user_question"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "ambiguous between local filesystem search and Drive search with no prior context to disambiguate -- either family of tools (or delegating to the traversal specialist) is acceptable. tools_any widened: dry-run's local-embedding shortlist doesn't reliably surface narrow filesystem tools for this indirect phrasing -- the LIVE lane is the faithful signal for the narrow-tool claim"}
{"id": "ambig_run_the_usual", "prompt": "run the usual thing for me", "category": "agent", "expect": {"tools_any": ["run_saved_routine", "run_routine", "manage_cron", "list_skills"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "ambiguous: 'the usual thing' has no referent -- selector should reach for the saved-routine family rather than inventing a one-off action"}
{"id": "ambig_wake_me_up_about_it", "prompt": "make sure I don't forget about it", "category": "agent", "expect": {"tools_any": ["set_reminder", "execute_future_task", "manage_cron"], "max_tools": 14}, "judge": ["tool_appropriateness"], "note": "ambiguous referent for 'it' but the ACTION (create a future reminder) is clear -- tests the selector separates action-type disambiguation from object disambiguation"}
{"id": "ambig_check_on_the_kids_class", "prompt": "how's my class going, anything new I should know?", "category": "agent", "expect": {"tools_any": ["get_canvas_dashboard_todos", "get_upcoming_assignments", "get_recent_grades", "get_course_announcements"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "ambiguous across 4 valid Canvas endpoints (todos/assignments/grades/announcements) for a vague 'anything new' ask -- any one is acceptable"}
{"id": "drive_known_id_read", "prompt": "read the Google Drive doc with file id 1AbCdefGhIjKlMnOpQrsTuvWxYz and summarize the first page", "category": "agent", "expect": {"tools_any": ["google_drive_read_file"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "known Drive file_id - supervisor should bind google_drive_read_file directly; traversal is optional/unnecessary for a single known-id read"}
{"id": "local_known_path_read", "prompt": "read C:\\Users\\ExampleUser\\Documents\\notes\\standup.md and give me the bullet points", "category": "agent", "expect": {"tools_any": ["read_file"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "known local path - supervisor should bind read_file directly; do not require delegate_to_traversal_agent"}
{"id": "explore_downloads_folder", "prompt": "dig through my Downloads folder and find anything that looks like a tax form from last year", "category": "agent", "expect": {"tools_any": ["delegate_to_traversal_agent", "fuzzy_find_local", "list_directory"], "max_tools": 16}, "judge": ["tool_appropriateness"], "note": "open-ended explore/search-through - traversal is the preferred path; direct FS tools also acceptable if selector surfaces them"}
