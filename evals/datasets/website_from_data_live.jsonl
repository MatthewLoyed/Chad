// website_from_data_live.jsonl — issue #413: "build a website from Google Drive / email data" —
// a multi-step chain of gather (drive search / gmail search) -> synthesize -> build_html_file
// (web-artifacts-builder skill), distinct from a plain research+file writeup because the SOURCE
// is the user's own data, not the web. Read-only on the source side (search/read only, never
// modifies Drive files or emails); the only side effect is a new local HTML artifact. LIVE lane.
{"id": "website_from_drive_docs_live", "prompt": "search my Google Drive for any documents related to 'project notes' and build me a simple single-page website summarizing what you find", "category": "agent", "expect": {"tools_any": ["google_drive_search"], "max_duration_s": 180}, "judge": ["tool_appropriateness", "response_grounded"], "note": "drive-sourced website; catches a model that fabricates content instead of grounding the page in what it actually found (or found nothing)"}
{"id": "website_from_email_thread_live", "prompt": "look through my recent emails for anything about upcoming plans or events, and build a simple webpage with a timeline of the key dates you find", "category": "agent", "expect": {"tools_any": ["search_gmail", "gmail_check_inbox"], "max_duration_s": 180}, "judge": ["tool_appropriateness", "response_grounded"], "note": "email-sourced website; response should reflect ACTUAL emails found, not invented dates -- a graceful 'nothing relevant found' is a valid pass, silently inventing a timeline is not"}
{"id": "website_from_drive_resume_portfolio_live", "prompt": "find my resume in Google Drive and turn its content into a simple one-page personal portfolio website", "category": "agent", "expect": {"tools_any": ["google_drive_search", "google_drive_read_file"], "max_duration_s": 180}, "judge": ["tool_appropriateness", "response_grounded"], "note": "requires both search AND read (not just listing filenames) to actually source real content for the page"}
{"id": "website_no_data_found_graceful_live", "prompt": "search my Google Drive for files about 'nonexistent_topic_xyz_12345' and if you find something, build a website about it", "category": "agent", "expect": {"tools_any": ["google_drive_search"], "response_excludes": ["here is your website", "i've built a website"], "max_duration_s": 120}, "judge": ["response_grounded"], "note": "negative case: nothing should exist for this made-up topic -- correct behavior is reporting nothing found, NOT fabricating a website anyway to seem helpful"}
