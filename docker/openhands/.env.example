# OpenHands sidecar config — copy to `.env` (gitignored) and fill in the two paths.
#   copy docker\openhands\.env.example docker\openhands\.env

# --- REQUIRED: machine-specific host paths (use WSL/Unix form, /mnt/c/..., NOT C:\...) ---

# Where OpenHands mounts the sandbox workspace. The part before ':' is the HOST dir
# (created if missing); '/workspace/project' is where the agent works inside the sandbox.
# For the first "build a project in an empty workspace" test, point this at a scratch dir:
OH_SANDBOX_VOLUMES=/mnt/c/Users/<you>/AppData/Local/Temp/oh-chad-workspace:/workspace/project:rw

# Persisted OpenHands config + conversation DB (settings.json etc). Reuse your existing
# ~/.openhands so the LM Studio model/settings you configured in the UI carry over:
OH_CONFIG_DIR=/mnt/c/Users/<you>/.openhands

# --- OPTIONAL: overrides (defaults shown; uncomment to change) ---

# OH_PORT=3001
# OH_IMAGE_TAG=latest
# OH_LLM_API_KEY=lmstudio
# OH_LLM_MODEL=openai/qwen/qwen3.6-35b-a3b
# OH_LLM_BASE_URL=http://host.docker.internal:1234/v1
