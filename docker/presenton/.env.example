# Copy to docker/presenton/.env and fill in values.
# Used by docker/chad-services.yml presenton service (profile: presenton).

# --- Chad + LM Studio (recommended — reuses your local model, no cloud key) ---
LLM=custom
CUSTOM_LLM_URL=http://host.docker.internal:1234/v1
CUSTOM_MODEL=google/gemma-4-26b-a4b-qat
CUSTOM_LLM_API_KEY=lm-studio
TOOL_CALL=true
DISABLE_IMAGE_GENERATION=true
CAN_CHANGE_KEYS=false
AUTH_USERNAME=chad
AUTH_PASSWORD=change-me-on-first-save

# --- Or use a cloud provider instead (comment out custom block above) ---
# LLM=google
# GOOGLE_API_KEY=
# LLM=openai
# OPENAI_API_KEY=

# Stock images (often required with ollama)
PEXELS_API_KEY=
